digraph ConnectorIDArchitecture {
  graph [
    label = <<FONT POINT-SIZE="26" COLOR="#f1f5f9"><B>Connector ID</B></FONT> <FONT POINT-SIZE="18" COLOR="#94a3b8">— Production Pipeline (2026-05-28)</FONT>>;
    labelloc = t;
    labeljust = c;
    fontname = "Helvetica";
    bgcolor = "#0a0e1a";
    pad = 0.4;
    rankdir = LR;
    ranksep = 0.6;
    nodesep = 0.35;
    splines = spline;
    outputorder = edgesfirst;
    fontcolor = "#f1f5f9";
  ];

  node [
    shape = box;
    style = "rounded,filled";
    fontname = "Helvetica";
    fontsize = 12;
    fontcolor = "#f8fafc";
    color = "#1e293b";
    penwidth = 1.5;
    margin = "0.18,0.12";
    height = 0.4;
  ];

  edge [
    fontname = "Helvetica";
    fontsize = 10;
    color = "#64748b";
    fontcolor = "#94a3b8";
    arrowsize = 0.8;
    penwidth = 1.5;
  ];

  // ============================================================
  // CLIENT
  // ============================================================
  subgraph cluster_client {
    label = <<FONT POINT-SIZE="13" COLOR="#a78bfa"><B>FLUTTER CLIENT</B></FONT>>;
    style = "rounded,filled";
    fillcolor = "#13182a";
    color = "#312e54";
    penwidth = 1.5;
    fontname = "Helvetica";
    margin = 16;

    camera [
      label = <<B>Camera</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">photo or video frame</FONT>>;
      shape = folder;
      fillcolor = "#3b1f6b";
      color = "#7c3aed";
    ];

    reticle [
      label = <<B>On-device reticle crop</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">centered 60% min-dim square<BR/>training scale = inference scale</FONT>>;
      fillcolor = "#3b1f6b";
      color = "#7c3aed";
    ];

    result [
      label = <<B>Result card</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">top-1 + confidence<BR/>abstains below 0.65</FONT>>;
      fillcolor = "#3b1f6b";
      color = "#7c3aed";
    ];

    contribute [
      label = <<B>Contribute tab</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">user-classified captures<BR/>→ labeler API</FONT>>;
      shape = folder;
      fillcolor = "#3b1f6b";
      color = "#7c3aed";
    ];
  }

  // ============================================================
  // SERVER — inference path
  // ============================================================
  subgraph cluster_server {
    label = <<FONT POINT-SIZE="13" COLOR="#67e8f9"><B>INFERENCE SERVICE</B></FONT>>;
    style = "rounded,filled";
    fillcolor = "#0a1726";
    color = "#0e7490";
    penwidth = 1.5;
    fontname = "Helvetica";
    margin = 16;

    api [
      label = <<B>FastAPI  /predict</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">legacy response shape preserved<BR/>X-Device-Token auth</FONT>>;
      fillcolor = "#0c4a6e";
      color = "#38bdf8";
    ];

    detector [
      label = <<B>YOLO11n detector</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">single "connector" class<BR/>mAP50 ≈ 0.979</FONT>>;
      fillcolor = "#155e75";
      color = "#22d3ee";
    ];

    bestbox [
      label = <<B>Best-CLS-conf box selection</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">classify every detection,<BR/>pick the one with highest<BR/>classifier confidence</FONT>>;
      fillcolor = "#155e75";
      color = "#22d3ee";
    ];

    reticlefilter [
      label = <<B>Reticle-region filter</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">drop off-center detections<BR/>fallback to center crop</FONT>>;
      fillcolor = "#155e75";
      color = "#22d3ee";
    ];

    classifier [
      label = <<B>EfficientNetV2-S  @ 384²</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">combined_v7 (distance-varied)<BR/>PIL.BILINEAR preprocessing</FONT>>;
      fillcolor = "#155e75";
      color = "#22d3ee";
    ];

    specs [
      label = <<B>connectors.yaml</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">family, gender, polarity<BR/>frequency, impedance, coupling</FONT>>;
      shape = folder;
      fillcolor = "#064e3b";
      color = "#34d399";
    ];

    response [
      label = <<B>JSON response</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">class, confidence, bbox<BR/>family, gender, spec</FONT>>;
      fillcolor = "#7c2d12";
      color = "#fb923c";
    ];

    // Keep best-CLS-conf + reticle-filter side-by-side inside this cluster
    { rank = same; bestbox; reticlefilter; }
    // Keep spec lookup + JSON response side-by-side inside this cluster
    { rank = same; specs; response; }
  }

  // ============================================================
  // DATA LOOP
  // ============================================================
  subgraph cluster_data {
    label = <<FONT POINT-SIZE="13" COLOR="#fbbf24"><B>DATA FEEDBACK LOOP</B></FONT>>;
    style = "rounded,filled";
    fillcolor = "#1a1308";
    color = "#854d0e";
    penwidth = 1.5;
    fontname = "Helvetica";
    margin = 16;

    labeler [
      label = <<B>Labeler service</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">aired.com/rfcai/labeler<BR/>browse + bulk-edit datasets</FONT>>;
      shape = folder;
      fillcolor = "#713f12";
      color = "#facc15";
    ];

    snapshot [
      label = <<B>Training snapshot</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">e.g. combined_v7_2026-05-28<BR/>3,804 samples</FONT>>;
      shape = folder;
      fillcolor = "#713f12";
      color = "#facc15";
    ];

    train [
      label = <<B>Train &amp; eval</B><BR/><FONT POINT-SIZE="10" COLOR="#cbd5e1">EffNetV2-S, scale (0.20, 1.0)<BR/>holdouts: close52, phone-v2, today</FONT>>;
      fillcolor = "#713f12";
      color = "#facc15";
    ];
  }

  // ============================================================
  // WIRING — primary inference path
  // ============================================================
  camera -> reticle [label = " shutter"];
  reticle -> api [label = " POST image", penwidth = 2.0, color = "#94a3b8"];
  api -> detector [label = " bgr frame"];
  detector -> bestbox;
  bestbox -> reticlefilter;
  reticlefilter -> classifier;
  classifier -> specs [label = " top class"];
  specs -> response [label = " enrich"];
  response -> result [label = " HTTP 200", penwidth = 2.0, color = "#94a3b8"];

  // ============================================================
  // WIRING — data feedback loop
  // ============================================================
  result -> contribute [label = " confirm /\l relabel", style = dashed, color = "#fbbf24", fontcolor = "#fbbf24"];
  contribute -> labeler [label = " POST capture", style = dashed, color = "#fbbf24", fontcolor = "#fbbf24"];
  labeler -> snapshot [label = " carve", style = dashed, color = "#fbbf24", fontcolor = "#fbbf24"];
  snapshot -> train [label = " batches", style = dashed, color = "#fbbf24", fontcolor = "#fbbf24"];
  train -> classifier [label = " new weights", style = dashed, color = "#fbbf24", fontcolor = "#fbbf24"];

}
