digraph ConnectorIDReadmeArchitecture {
  graph [
    label="Connector ID - Production Pipeline (2026-05-28)";
    labelloc=t;
    fontsize=22;
    fontname="Arial Bold";
    bgcolor="#f7f9fc";
    pad=0.3;
    rankdir=TB;
    ranksep=0.5;
    nodesep=0.4;
    splines=spline;
    outputorder=edgesfirst;
  ];

  node [
    shape=box;
    style="rounded,filled";
    fontname="Arial";
    fontsize=12;
    margin="0.14,0.10";
    color="#2f3b52";
    penwidth=1.5;
  ];

  edge [
    fontname="Arial";
    fontsize=10;
    color="#56677a";
    arrowsize=0.8;
    penwidth=1.4;
  ];

  // --- Client side ---
  camera [
    label="Camera (Flutter app)\nphoto or video";
    shape=folder;
    fillcolor="#efe6ff:#fbf8ff";
    gradientangle=90;
  ];

  reticle [
    label="On-device crop\ncentered 60%-min-dim square\n(training = inference scale)";
    fillcolor="#efe6ff:#fbf8ff";
    gradientangle=90;
  ];

  // --- API boundary ---
  api [
    label="FastAPI /predict\n(legacy response shape preserved)";
    fillcolor="#d9ecff:#f7fbff";
    gradientangle=90;
  ];

  // --- Inference path ---
  detector [
    label="YOLO11n detector\nsingle 'connector' class";
    fillcolor="#cfe6ff:#f8fbff";
    gradientangle=90;
  ];

  bestbox [
    label="Best-CLS-conf box selection\nclassify all detections,\npick highest classifier conf";
    fillcolor="#cfe6ff:#f8fbff";
    gradientangle=90;
  ];

  reticlefilter [
    label="Reticle-region filter\ndrop off-center detections,\nfallback to center crop";
    fillcolor="#cfe6ff:#f8fbff";
    gradientangle=90;
  ];

  classifier [
    label="EfficientNetV2-S\nat 384x384, PIL.BILINEAR\ntrained on distance-varied data";
    fillcolor="#cfe6ff:#f8fbff";
    gradientangle=90;
  ];

  // --- Output side ---
  specs [
    label="connectors.yaml\nfamily, gender, polarity,\nfrequency, impedance, coupling";
    shape=folder;
    fillcolor="#e5f7e7:#f8fff8";
    gradientangle=90;
  ];

  response [
    label="JSON response\nclass, confidence, bbox,\nfamily, gender, spec";
    fillcolor="#fff1cc:#fffaf0";
    gradientangle=90;
  ];

  result [
    label="Result card (Flutter)\ntop-1 with confidence,\nabstains below 0.65";
    fillcolor="#fff1cc:#fffaf0";
    gradientangle=90;
  ];

  // --- Data loop ---
  contribute [
    label="Contribute tab (Flutter)\nuser-classified captures\n-> labeler API";
    shape=folder;
    fillcolor="#e5f7e7:#f8fff8";
    gradientangle=90;
  ];

  train [
    label="Training snapshots\n+ holdout evaluation";
    shape=folder;
    fillcolor="#e5f7e7:#f8fff8";
    gradientangle=90;
  ];

  // --- Wiring ---
  camera -> reticle [label="shutter"];
  reticle -> api [label="POST image"];
  api -> detector [label="bgr frame"];
  detector -> bestbox;
  bestbox -> reticlefilter;
  reticlefilter -> classifier;
  classifier -> specs [label="top class"];
  specs -> response [label="enrich"];
  response -> result [label="display"];
  result -> contribute [label="confirm/relabel", style=dashed, color="#5a9b62"];
  contribute -> train [label="upload", style=dashed, color="#5a9b62"];
  train -> classifier [label="periodic retrain", style=dashed, color="#5a9b62"];

  { rank=same; bestbox; reticlefilter; }
}
